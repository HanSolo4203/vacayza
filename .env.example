# Set to true or 1 to show the coming-soon gate for all routes (via middleware).
# Omit or set to false for the normal site. Configure per environment in Vercel:
# Project → Settings → Environment Variables → Production / Preview / Development.
COMING_SOON=true

# Optional: share ?bypass=<this value> once to set an httpOnly preview cookie (30 days).
# Leave unset to disable preview bypass.
# COMING_SOON_BYPASS_SECRET=

# Supabase (property listings)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Mapbox GL (3D property maps)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Optional: Supabase MCP (Cursor) — Personal Access Token with all scopes
# https://supabase.com/dashboard/account/tokens
# SUPABASE_ACCESS_TOKEN=
